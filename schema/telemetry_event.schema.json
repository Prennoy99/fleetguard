{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Prennoy99/fleetguard/schema/telemetry_event.schema.json",
  "title": "VehicleTelemetryEvent",
  "description": "Single 5-minute telemetry sample for one vehicle, written by the batch generator into telemetry_raw. Field set and ranges are reused from the fleetpulse project's event schema (same signals, same units) so the synthetic data stays realistic; the sampling cadence and generation mode (deterministic batch, not a live Kafka stream) are specific to FleetGuard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vehicle_id",
    "event_time",
    "speed_kmh",
    "rpm",
    "gear",
    "throttle_pct",
    "brake_pct",
    "fuel_level_pct",
    "fuel_rate_lh",
    "engine_temp_c",
    "oil_pressure_bar",
    "battery_v",
    "latitude",
    "longitude",
    "altitude_m",
    "hard_brake",
    "harsh_accel",
    "lane_departure"
  ],
  "properties": {
    "vehicle_id":        { "type": "string" },
    "event_time":        { "type": "string", "format": "date-time" },
    "speed_kmh":         { "type": "number" },
    "rpm":               { "type": "integer" },
    "gear":              { "type": "integer", "minimum": 1, "maximum": 6 },
    "throttle_pct":      { "type": "number" },
    "brake_pct":         { "type": "number" },
    "fuel_level_pct":    { "type": "number" },
    "fuel_rate_lh":      { "type": "number" },
    "engine_temp_c":     { "type": "number" },
    "oil_pressure_bar":  { "type": "number" },
    "battery_v":         { "type": "number" },
    "latitude":          { "type": "number", "minimum": -90, "maximum": 90 },
    "longitude":         { "type": "number", "minimum": -180, "maximum": 180 },
    "altitude_m":        { "type": "number" },
    "hard_brake":        { "type": "boolean" },
    "harsh_accel":       { "type": "boolean" },
    "lane_departure":    { "type": "boolean" }
  }
}
