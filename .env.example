# Local Postgres (docker-compose.yml). Copy to .env and adjust if needed.
DATABASE_URL=postgresql://fleetguard:fleetguard@localhost:5432/fleetguard

# --- Gemini (agent reasoning, from M3 onward) ---
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- FleetGuard's own service auth ---
# Any random string; required by /diagnose and /incidents/* endpoints via the X-API-Key header.
API_KEY=
